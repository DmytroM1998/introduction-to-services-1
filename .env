# resource-db
POSTGRES_DB_RESOURCE_SERVICE=resource-db
POSTGRES_USER_RESOURCE_SERVICE=postgres
POSTGRES_PASSWORD_RESOURCE_SERVICE=postgres
HOST_PORT_RESOURCE_DB=5432
CONTAINER_PORT_RESOURCE_DB=5432

# song-db
POSTGRES_DB_SONG_SERVICE=song-db
POSTGRES_USER_SONG_SERVICE=postgres
POSTGRES_PASSWORD_SONG_SERVICE=postgres
# 5433 is set to avoid the port conflict with resource-db
HOST_PORT_SONG_DB=5433
CONTAINER_PORT_SONG_DB=5432

# eureka-server
EUREKA_SERVER_PORT=8761
EUREKA_SERVER_HOST=eureka-server
EUREKA_SERVER_APPLICATION_NAME=eureka-server
EUREKA_SERVER_REGISTER_WITH_EUREKA=false
EUREKA_SERVER_FETCH_REGISTRY=false
EUREKA_SERVER_LOG_LEVEL=OFF
EUREKA_DISCOVERY_LOG_LEVEL=OFF
EUREKA_LEASE_RENEWAL_INTERVAL_IN_SECONDS=5
EUREKA_REGISTRY_FETCH_INTERVAL_IN_SECONDS=5

# localstack
LOCALSTACK_PORT=4566
AWS_REGION=us-east-1
LOCALSTACK_SERVICES=s3
LOCALSTACK_DEBUG=0
LOCALSTACK_PERSISTENCE=0

# rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_DEFAULT_USER=app
RABBITMQ_DEFAULT_PASS=app

# api-gateway
API_GATEWAY_SERVER_APPLICATION_NAME=api-gateway
API_GATEWAY_SERVER_PORT=8110

# resource-service
RESOURCE_SERVICE_APPLICATION_NAME=resource-service
RESOURCE_DB_URL=jdbc:postgresql://resource-db:5432/resource-db
RESOURCE_SERVICE_REF_NAME=resource-service
RESOURCE_SERVICE_SERVER_PORT=8091
RESOURCE_STORAGE_BUCKET=resources
RESOURCE_STORAGE_ENDPOINT=http://localstack:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
STORAGE_CIRCUIT_BREAKER_WINDOW_SIZE=1
STORAGE_CIRCUIT_BREAKER_MINIMUM_CALLS=1
STORAGE_CIRCUIT_BREAKER_FAILURE_RATE=50
STORAGE_CIRCUIT_BREAKER_OPEN_DURATION=10s
STORAGE_CIRCUIT_BREAKER_HALF_OPEN_CALLS=2
# JVM debugging
RESOURCE_SERVICE_DEBUG_HOST_PORT=5005
RESOURCE_SERVICE_DEBUG_CONTAINER_PORT=5005

# resource-processor
RESOURCE_PROCESSOR_APPLICATION_NAME=resource-processor
RESOURCE_PROCESSOR_WEB_APPLICATION_TYPE=none
RESOURCE_PROCESSOR_FUNCTION_DEFINITION=resourceMessageListener
RESOURCE_PROCESSOR_STREAM_GROUP=resource-processor
RESOURCE_RABBITMQ_EXCHANGE=resource.uploaded
RABBITMQ_HOST=rabbitmq

# song-service
SONG_SERVICE_APPLICATION_NAME=song-service
SONG_DB_URL=jdbc:postgresql://song-db:5432/song-db
SONG_SERVICE_REF_NAME=song-service
SONG_SERVICE_SERVER_PORT=8092
SONG_SERVICE_SERVER_PORT_2ND_SERVICE=8093
# JVM debugging
SONG_SERVICE_DEBUG_HOST_PORT=5006
SONG_SERVICE_DEBUG_HOST_PORT_2ND_SERVICE=5007
SONG_SERVICE_DEBUG_CONTAINER_PORT=5005

# storage
STORAGE_SERVICE_REF_NAME=storage
STORAGE_SERVER_PORT=8086
HOST_PORT_STORAGE_DB=5434
CONTAINER_PORT_STORAGE_DB=5432
STORAGE_DB_URL=jdbc:postgresql://storage-db:5432/storage-db
POSTGRES_DB_STORAGE_SERVICE=storage-db
POSTGRES_USER_STORAGE_SERVICE=postgres
POSTGRES_PASSWORD_STORAGE_SERVICE=postgres
STAGING_STORAGE_BUCKET=resources-staging
PERMANENT_STORAGE_BUCKET=resources-permanent
STAGING_STORAGE_PATH=resources/staging/
PERMANENT_STORAGE_PATH=resources/permanent/
EUREKA_SERVER_URL=http://eureka-server:8761/eureka/
EUREKA_CLIENT_FETCH_REGISTRY=true

# shared Spring configuration
SPRING_DATASOURCE_DRIVER_CLASS_NAME=org.postgresql.Driver
SPRING_JPA_DATABASE_PLATFORM=org.hibernate.dialect.PostgreSQLDialect
SPRING_JPA_HIBERNATE_DDL_AUTO=none
SPRING_DOCKER_COMPOSE_ENABLED=false
